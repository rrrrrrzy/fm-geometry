# fm-geometry environment defaults.
#
# Copy to `.env` (gitignored) and edit for your layout. Entries here become defaults for the
# argparse flags; CLI arguments and pre-existing shell variables still win. Use absolute paths —
# no `${VAR}` expansion is performed.
#
# None of this is needed to *analyze* an existing recording, or to run the toy figure. It only
# matters when producing a new recording (see docs/reproduce.md).

# --- Model checkpoint --------------------------------------------------------

# π₀.₅ fine-tuned on LIBERO, in LeRobot/HF format: a directory containing
# config.json + model.safetensors + policy_{pre,post}processor*.
# Also settable per-run with `--checkpoint`.
PI05_LIBERO_CHECKPOINT=data/models/pi05-libero-hf

# --- Dataset ----------------------------------------------------------------

# LeRobot-format LIBERO dataset. Only needed for the teacher-forced execution mode;
# closed-loop eval builds the LIBERO envs directly.
# LIBERO_LEROBOT_DATASET=data/datasets/LIBERO

# --- Outputs ----------------------------------------------------------------

# Root for run directories, figures and tables. Every stage reads and writes under here, so
# pointing it at an existing tree of recordings is how you score runs stored elsewhere.
FMACCEL_OUTPUT_DIR=outputs

# --- Hugging Face -----------------------------------------------------------

# Read only from the local HF cache and skip per-call ETag requests. π₀.₅ reloads its tokenizer
# every time it builds the preprocessor pipeline, so this removes a lot of per-run network noise.
# Set to 0 when you actually need to fetch a new repo.
HF_HUB_OFFLINE=1
